# Origen de Enlyce.Api. Debe estar autorizado en la politica CORS del backend.
NEXT_PUBLIC_API_URL=http://localhost:5019
# Origen publico del sitio, usado por metadatos, sitemap y robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mosaicos externos; proveedor por defecto OpenStreetMap (sin SLA propio).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Redes sociales publicas. Facebook se oculta mientras la URL este vacia.
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/lyc_propiedad_raiz_sas
NEXT_PUBLIC_FACEBOOK_URL=
