@startuml
title ENLYCE - Diagrama de clases del dominio principal
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty methods

class Asesor {
  +Id: Guid
  +Nombre: string
  +Correo: Email
  -PasswordHash: string
  +Rol: string
  +Activo: bool
  +VerificarPassword(password): bool
}

class Lead {
  +Id: Guid
  +Nombre: string
  +Email: Email
  +Telefono: Telefono?
  +Fuente: string
  +Estado: EstadoLead
  +AsesorAsignadoId: Guid?
  +EtapaPipeline: string
  +AutorizacionDatos: bool
  +Activo: bool
}

class Interaccion {
  +Id: Guid
  +LeadId: Guid
  +AsesorId: Guid
  +Tipo: string
  +Resumen: string?
  +Fecha: DateTime
}

class Visita {
  +Id: Guid
  +LeadId: Guid
  +InmuebleId: Guid
  +AsesorId: Guid
  +FechaProgramada: DateTime
  +FechaRealizada: DateTime?
  +Estado: string
}

class Consentimiento {
  +Id: Guid
  +LeadId: Guid
  +Fecha: DateTime
  +TextoConsentido: string
  +VersionPolitica: string
  +Metodo: string
}

class Inmueble {
  +Id: Guid
  +Nombre: string
  +Tipo: TipoInmueble
  +Modalidad: ModalidadInmueble
  +Estado: EstadoInmueble
  +Direccion: Direccion
  +Precio: Dinero
  +PropietarioId: Guid
  +Activo: bool
}

class Propietario {
  +Id: Guid
  +Nombre: string
  +Email: Email
  +Telefono: Telefono?
  +Activo: bool
}

class Email <<value object>> {
  +Value: string
}

class Telefono <<value object>> {
  +Value: string
}

class Direccion <<value object>> {
  +Calle: string
  +Ciudad: string
  +Barrio: string?
}

class Dinero <<value object>> {
  +Monto: decimal
  +Moneda: string
}

Lead "1" -- "0..*" Interaccion : registra >
Lead "1" -- "0..*" Visita : agenda >
Lead "1" -- "0..*" Consentimiento : autoriza >

Asesor "1" .. "0..*" Lead : asignado a\nFK no configurada
Asesor "1" .. "0..*" Interaccion : realizada por\nFK no configurada
Asesor "1" .. "0..*" Visita : responsable\nFK no configurada
Inmueble "1" .. "0..*" Visita : inmueble visitado\nFK no configurada
Propietario "1" .. "0..*" Inmueble : posee\nFK no configurada

Asesor *-- Email
Lead *-- Email
Lead *-- Telefono
Propietario *-- Email
Propietario *-- Telefono
Inmueble *-- Direccion
Inmueble *-- Dinero

note bottom
  Líneas continuas: relaciones configuradas en EF Core.
  Líneas punteadas: relación conceptual mediante identificador,
  sin clave foránea configurada en el modelo actual.
end note
@enduml
