@startuml
title ENLYCE — Capacidades principales por actor
left to right direction
skinparam backgroundColor #F8F4EA
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName "Times New Roman"
skinparam defaultFontColor #26352F
skinparam ArrowColor #6B766F
skinparam actor {
  BorderColor #742A3A
  BackgroundColor #F8F4EA
  FontColor #26352F
}
skinparam usecase {
  BorderColor #66796E
  BackgroundColor #FCFAF4
  FontColor #26352F
}
skinparam rectangle {
  BorderColor #B08A4B
  BackgroundColor #F8F4EA
  FontColor #26352F
}
skinparam package {
  BorderColor #B08A4B
  FontColor #26352F
}
skinparam note {
  BorderColor #B08A4B
  BackgroundColor #FFF8DF
  FontColor #4D4538
}

actor Administrador as admin
actor Asesor as advisor
actor Visitante as visitor

rectangle "SISTEMA ENLYCE" as system {
  package "ADMINISTRACIÓN" #EFE6D5 {
    together {
      usecase "Registrar asesor" as registerAdvisor
      usecase "Asignar o reasignar\noportunidad" as assignLead
      usecase "Gestionar datos\npersonales" as personalData
    }
  }
  package "GESTIÓN COMERCIAL" #F1E5E7 {
    together {
      usecase "Registrar oportunidad\ncomercial" as registerLead
      usecase "Gestionar etapas\nde venta" as managePipeline
      usecase "Registrar\ninteracción" as registerInteraction
      usecase "Agendar visita" as scheduleVisit
      usecase "Gestionar\ninmuebles" as manageProperties
    }
  }
  package "PORTAL PÚBLICO" #E4ECE6 {
    together {
      usecase "Consultar catálogo" as viewCatalog
      usecase "Solicitar información\n(genera una oportunidad)" as requestInfo
    }
  }
}

admin --> registerAdvisor
admin --> assignLead
admin --> personalData
advisor --> registerLead
advisor --> managePipeline
advisor --> registerInteraction
advisor --> scheduleVisit
advisor --> manageProperties
visitor --> viewCatalog
visitor --> requestInfo

admin -[hidden]down- advisor
advisor -[hidden]down- visitor
registerAdvisor -[hidden]down- registerLead
registerLead -[hidden]down- viewCatalog

legend bottom
  |= Cómo leer el diagrama |
  | Una **oportunidad comercial** representa a una persona interesada en un inmueble. |
  | Cuando un visitante solicita información, ENLYCE registra esa oportunidad. |
  | Asesor y Administrador deben iniciar sesión antes de las operaciones privadas. |
  | Solo el Administrador puede registrar asesores. |
endlegend
@enduml
